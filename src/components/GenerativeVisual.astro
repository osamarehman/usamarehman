---
interface Props { kind: string; label?: string }
const { kind, label = 'System study' } = Astro.props;
---

<div class:list={['generative-preview', `preview-${kind}`]} role="img" aria-label={`${label}, generative system diagram`}>
  <div class="preview-orbit"><i></i><i></i><i></i></div>
  <div class="preview-stack"><i></i><i></i><i></i><i></i></div>
  <div class="preview-node node-a"></div>
  <div class="preview-node node-b"></div>
  <div class="preview-node node-c"></div>
  <span class="preview-signal"></span>
</div>
