---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowUpRight } from './Icons';
import { PRODUCTS } from '../data/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  cover: ImageMetadata;
}

const { cover } = Astro.props;
---

<section class="section shell" id="products" aria-labelledby="products-title">
  <SectionHeading id="products-title" index="03" label="my own products" title="Things I build" accent="and run myself." description="Separate from client work. Public links are included only where the product is available." />

  <article class="product-feature" data-reveal>
    <a class="product-feature-visual" href="/work/runova-crm" aria-label="Read the Runova CRM case study">
      <Image src={cover} alt="Runova CRM dashboard with demo data" widths={[720, 1080, 1440]} sizes="(max-width: 900px) 100vw, 62vw" loading="lazy" />
      <span class="image-caption">Runova CRM · My own product · Demo data</span>
    </a>
    <div class="product-feature-copy">
      <p class="mono-label">01 // CRM + AI Coworker</p>
      <h3>Runova CRM</h3>
      <p>Lead, sales, sold and production pipelines, a 7-step appointment workflow, trade estimating, proposals, calendars and an AI Coworker.</p>
      <div class="product-proof"><span>6 trade estimators</span><span>7-step workflow</span><span>Active development</span></div>
      <div class="product-links">
        <a class="button button-small" href="https://crm.runova.dev" target="_blank" rel="noreferrer">Open public demo <ArrowUpRight size={14} /></a>
        <a class="text-link" href="/work/runova-crm">Product details <span>→</span></a>
      </div>
    </div>
  </article>

  <div class="products-grid" data-reveal>
    {PRODUCTS.map((product) => (
      <article class="product-card" data-tilt>
        <div class:list={['product-glyph', `glyph-${product.art}`]} aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="product-card-head"><span>{product.index}</span><span>{product.status}</span></div>
        <h3>{product.name}</h3>
        <p>{product.description}</p>
        <div class="product-card-bottom">
          <small>{product.proof}</small>
          {product.href && <a href={product.href} target="_blank" rel="noreferrer" aria-label={`Open ${product.name}`}><ArrowUpRight size={17} /></a>}
        </div>
      </article>
    ))}
  </div>
</section>
