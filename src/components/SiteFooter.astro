---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">u<span>.</span></span>
        <span class="brand-copy">{SITE.name}<small>{SITE.location} · {SITE.timezone}</small></span>
      </a>
      <p class="footer-note">Ordinary code in a repo you own, running on a server in your cloud account.</p>
    </div>
    <div class="footer-links">
      <p class="mono-label">Elsewhere</p>
      <a href={SITE.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a>
      <a href={SITE.links.upwork} target="_blank" rel="noreferrer">Upwork <span>↗</span></a>
      <a href={SITE.links.github} target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
      <a href={SITE.links.x} target="_blank" rel="noreferrer">X <span>↗</span></a>
    </div>
    <div class="footer-links">
      <p class="mono-label">Direct</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email} <span>↗</span></a>
      <a href="tel:+12408203353">AI phone agent demo <span>↗</span></a>
      <p class="footer-time"><span class="status-dot"></span><span data-local-clock>UTC+5</span></p>
    </div>
  </div>
  <div class="shell colophon">
    <span>© {year} Usama Rehman</span>
    <span>Built with Astro and Three.js</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
