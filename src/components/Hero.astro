---
import { ArrowUpRight, Phone } from './Icons';
import { SITE, PROOF_STATS } from '../data/site';
import MosaicField from './react/MosaicField';
import MosaicFallback from './MosaicFallback.astro';
import ClientRail from './ClientRail.astro';
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="hero-kicker"><span class="status-dot"></span>{SITE.location}<span class="hero-kicker-separator">/</span><span data-local-clock>UTC+5</span></p>
      <h1 id="hero-title">
        I build the systems a business <em>runs on.</em>
        <span>I stay on to run them.</span>
      </h1>
      <p class="hero-lead">{SITE.lead}</p>
      <div class="hero-actions">
        <a class="button" href="#work">Explore selected work <ArrowUpRight size={15} strokeWidth={1.7} /></a>
        <a class="text-link" href="tel:+12408203353"><Phone size={15} strokeWidth={1.7} /> Call the AI phone agent</a>
      </div>
      <p class="hero-hours">{SITE.hours}</p>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="hero-fallback" aria-hidden="true"><MosaicFallback /></div>
      <MosaicField client:only="react" />
    </div>
  </div>

  <div class="hero-proof" data-reveal>
    {PROOF_STATS.slice(0, 4).map((stat) => (
      <div class="hero-stat"><strong data-count="true">{stat.value}</strong><span>{stat.label}</span></div>
    ))}
  </div>

  <ClientRail />
</section>
