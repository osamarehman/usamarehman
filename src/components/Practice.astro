---
import { PROCESS } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section shell practice-section" aria-labelledby="process-title">
  <SectionHeading id="process-title" index="05" label="how I work" title="From the workflow" accent="to a system I run." description="Start with the real workflow, build from what it shows, and keep the system running after launch." />
  <ol class="process-grid" data-reveal>
    {PROCESS.map((step) => (
      <li class="process-step">
        <span class="process-number">{step.index}</span>
        <div class="process-line"><span></span></div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
