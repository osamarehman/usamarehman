---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import '../styles/refinements.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${SITE.name} | ${SITE.role}`,
  description = SITE.lead,
  image = '/profile.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const socialImage = new URL(image, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0d0d0f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/profile.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="google-site-verification" content="BkEn1Tsx2UXDJBXvt7isQOyqi_3Jl7o6GZ7FxHIF1nE" />
    <title>{title}</title>
    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important;filter:none!important}.about-statement span{opacity:1!important}</style></noscript>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('usamar.theme.v2') || 'dark';
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0d0d0f' : '#f4f1ea';
        } catch (_) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      url: SITE.url,
      jobTitle: SITE.role,
      email: `mailto:${SITE.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Hyderabad', addressCountry: 'PK' },
      sameAs: Object.values(SITE.links),
    })} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />

    <script>
      const root = document.documentElement;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const updateThemeControls = () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          button.setAttribute('aria-label', `Switch to ${next} theme`);
          button.setAttribute('title', `Switch to ${next} theme`);
        });
      };

      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0d0d0f' : '#f4f1ea');
          try { localStorage.setItem('usamar.theme.v2', theme); } catch (_) {}
          window.dispatchEvent(new CustomEvent('portfolio:theme', { detail: theme }));
          updateThemeControls();
        });
      });
      updateThemeControls();

      const menuButton = document.querySelector('[data-menu-toggle]');
      const mobileMenu = document.querySelector('#mobile-menu');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        menuButton.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
        if (mobileMenu) (mobileMenu as HTMLElement).hidden = open;
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        (mobileMenu as HTMLElement).hidden = true;
      }));

      const clock = () => {
        const value = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Asia/Karachi', hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(new Date());
        document.querySelectorAll('[data-local-clock]').forEach((element) => {
          element.textContent = `${value} UTC+5`;
        });
      };
      clock();
      window.setInterval(clock, 30000);

      const revealElements = document.querySelectorAll('[data-reveal]');
      const counterElements = document.querySelectorAll<HTMLElement>('[data-count]');

      const animateCounter = (element: HTMLElement) => {
        if (element.dataset.counted === 'true') return;
        const final = element.textContent?.trim() || '';
        const target = Number(final.replace(/[^0-9.]/g, ''));
        if (!Number.isFinite(target)) return;
        element.dataset.counted = 'true';
        if (reducedMotion.matches) {
          element.textContent = final;
          return;
        }
        const prefix = final.match(/^\D*/)?.[0] || '';
        const suffix = final.match(/\D*$/)?.[0] || '';
        const decimals = final.includes('.') ? 1 : 0;
        const formatter = new Intl.NumberFormat('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        });
        const startedAt = performance.now();
        const step = (now: number) => {
          const ratio = Math.min(1, (now - startedAt) / 1150);
          const eased = 1 - Math.pow(1 - ratio, 3);
          element.textContent = `${prefix}${formatter.format(target * eased)}${suffix}`;
          if (ratio < 1) requestAnimationFrame(step);
          else element.textContent = final;
        };
        requestAnimationFrame(step);
      };

      const initializeReveals = () => {
        if (reducedMotion.matches || !('IntersectionObserver' in window)) {
          revealElements.forEach((element) => element.classList.add('is-visible'));
          counterElements.forEach(animateCounter);
          return;
        }
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
        revealElements.forEach((element) => revealObserver.observe(element));

        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target as HTMLElement);
              counterObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.4 });
        counterElements.forEach((element) => counterObserver.observe(element));
      };

      if (document.body.classList.contains('intro-active')) {
        window.addEventListener('portfolio:intro-complete', initializeReveals, { once: true });
      } else {
        initializeReveals();
      }

      if (!reducedMotion.matches && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('[data-spotlight]').forEach((card) => {
          const element = card as HTMLElement;
          element.addEventListener('pointermove', (event) => {
            const rect = element.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width;
            const y = (event.clientY - rect.top) / rect.height;
            element.style.setProperty('--glow-x', `${(x * 100).toFixed(1)}%`);
            element.style.setProperty('--glow-y', `${(y * 100).toFixed(1)}%`);
          });
        });
      }

      const scrollXElements = document.querySelectorAll<HTMLElement>('[data-scroll-x]');
      const aboutWords = Array.from(document.querySelectorAll<HTMLElement>('.about-statement span'));
      let ticking = false;
      const updateScroll = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        root.style.setProperty('--page-progress', String(scrollable > 0 ? window.scrollY / scrollable : 0));

        if (reducedMotion.matches) {
          aboutWords.forEach((word) => { word.style.opacity = '1'; });
          scrollXElements.forEach((element) => element.style.setProperty('--scroll-x', '0px'));
        } else {
          scrollXElements.forEach((element) => {
            const rect = element.getBoundingClientRect();
            const speed = Number(element.getAttribute('data-scroll-x')) || 0;
            const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / window.innerHeight;
            element.style.setProperty('--scroll-x', `${(-progress * speed * 600).toFixed(2)}px`);
          });

          const statement = document.querySelector<HTMLElement>('.about-statement');
          if (statement && aboutWords.length) {
            const rect = statement.getBoundingClientRect();
            const progress = Math.min(1, Math.max(0, (window.innerHeight * 0.84 - rect.top) / (rect.height + window.innerHeight * 0.38)));
            aboutWords.forEach((word, index) => {
              const local = Math.min(1, Math.max(0, progress * aboutWords.length - index * 0.82));
              word.style.opacity = String(0.14 + local * 0.86);
            });
          }
        }
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateScroll);
        }
      }, { passive: true });
      window.addEventListener('resize', updateScroll);
      updateScroll();
    </script>
  </body>
</html>
