---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceArtwork from '../../components/ServiceArtwork.astro';
import { ArrowUpRight } from '../../components/Icons';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const artFor = (kind: string) => kind === 'migration' ? 'migration' : kind === 'pipeline' ? 'workflow' : kind === 'configurator' ? 'phone' : kind === 'portal' ? 'portal' : kind === 'product' ? 'crm' : 'sheet';
---

<BaseLayout title="Selected work | Usama Rehman" description="Custom CRMs, member portals, AI agents, coded automations and internal tools built and operated by Usama Rehman.">
  <header class="page-hero shell" data-reveal>
    <p class="mono-label">Index // selected work</p>
    <h1>Systems built around<br /><em>the work itself.</em></h1>
    <p>Client engagements and my own products, kept distinct. Real workflows, architecture and production results.</p>
  </header>
  <section class="work-index shell" aria-label="All case studies">
    {work.map((entry) => (
      <a class="work-index-card" href={`/work/${entry.id}`} data-reveal>
        <div class:list={['work-index-visual', { 'work-index-blueprint': !entry.data.cover }]}>
          {entry.data.cover ? <Image src={entry.data.cover} alt={entry.data.coverAlt || ''} widths={[640, 960, 1280]} sizes="(max-width: 800px) 100vw, 45vw" loading="lazy" /> : <ServiceArtwork art={artFor(entry.data.kind)} />}
        </div>
        <div class="work-index-copy">
          <div class="work-index-meta"><span>{String(entry.data.order).padStart(2, '0')} / {entry.data.type}</span><span>{entry.data.category === 'product' ? 'My own product' : 'Client work'}</span></div>
          <h2>{entry.data.client}</h2>
          <p class="work-index-title">{entry.data.title}</p>
          <p>{entry.data.headlineMetric}</p>
          <span class="text-link">Read case study <ArrowUpRight size={15} /></span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
